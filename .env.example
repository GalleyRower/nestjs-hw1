# app
PORT=3000

# database, эти же переменные читает docker compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=hw1
DB_PASSWORD=
DB_NAME=hw1
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000

# jwt, секреты разные и не короче 32 символов
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# cookie с refresh-токеном, для SameSite=none нужен COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
